{
  "name": "tally-database-loader",
  "version": "1.0.0",
  "description": "",
  "main": "dist/cli.mjs",
  "type": "module",
  "bin": {
    "tallydb": "./dist/cli.mjs",
    "tally-db-connector": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsc -p src/tsconfig.json",
    "build:exe": "npm run build && bun build --compile --target=bun --windows-title \"Tally DB Connector\" --windows-description \"Tally DB Connector CLI\" --outfile=dist/tallydb.exe src/cli.mts",
    "build:gui-exe": "npm run build && bun build --compile --target=bun --windows-title \"Tally DB Connector GUI\" --windows-description \"Tally DB Connector GUI\" --outfile=dist/tallydb-gui.exe src/server.mts",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-win.ps1",
    "start": "node ./dist/cli.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "bench:export": "npm run build && node test/bench-export.mjs"
  },
  "author": "",
  "license": "ISC",
  "overrides": {
    "whatwg-url": "^14.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.4",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.0",
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.11.1",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.15.3",
    "pg": "^8.16.0",
    "pg-copy-streams": "^7.0.0",
    "tedious": "^19.1.3",
    "ws": "^8.18.2"
  }
}
